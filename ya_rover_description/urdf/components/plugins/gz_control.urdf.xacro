<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

	<xacro:macro name="gz_control">

		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find ya_rover_control)/config/rover_controllers.yaml</parameters>

				<ros>
					<!-- <namespace>${namespace}</namespace> -->
					<!-- <remapping>tf:=${namespace}/tf</remapping> -->
					<!-- <remapping>tf_static:=${namespace}/tf_static</remapping> -->
					<remapping>diff_drive_controller/cmd_vel:=cmd_vel</remapping>
					<remapping>diff_drive_controller/odom:=odom</remapping>
					<!-- <remapping>diff_drive_controller/tf_odometry:=tf</remapping> -->
				</ros>
			</plugin>
		</gazebo>
		
	</xacro:macro>

</robot>