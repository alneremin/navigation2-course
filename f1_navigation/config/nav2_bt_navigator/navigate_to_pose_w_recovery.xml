<root main_tree_to_execute="MainTree" BTCPP_format="4">

  <BehaviorTree ID="MainTree">

    <RecoveryNode number_of_retries="4">

      <!-- ===== ОСНОВНОЙ PIPELINE ===== -->
      <PipelineSequence name="NavigateWithReplanning">

        <!-- === ГЛОБАЛЬНОЕ ПЛАНИРОВАНИЕ === -->
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="3">

            <ComputePathToPose
                goal="{goal}"
                path="{path}"
                planner_id="GridBased"/>

            <ClearEntireCostmap
                service_name="global_costmap/clear_entirely_global_costmap"/>

          </RecoveryNode>
        </RateController>

        <!-- === ЛОКАЛЬНОЕ СЛЕДОВАНИЕ === -->
        <Fallback>

          <!-- Основной MPPI -->
          <RecoveryNode number_of_retries="1">
            <FollowPath
                path="{path}"
                controller_id="MPPI"
                server_name="follow_path"/>

            <ClearEntireCostmap
                service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>

          <!-- Медленный MPPI -->
          <RecoveryNode number_of_retries="1">
            <FollowPath
                path="{path}"
                controller_id="MPPI_SLOW"
                server_name="follow_path"/>

            <ClearEntireCostmap
                service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>

        </Fallback>

      </PipelineSequence>

      <!-- === RECOVERY === -->
      <Sequence name="RecoveryActions">

        <ClearEntireCostmap
            service_name="local_costmap/clear_entirely_local_costmap"/>

        <ClearEntireCostmap
            service_name="global_costmap/clear_entirely_global_costmap"/>

        <BackUp
            backup_dist="0.5"
            backup_speed="0.1"
            server_name="backup"
            server_timeout="10"/>

      </Sequence>

    </RecoveryNode>

  </BehaviorTree>

</root>
